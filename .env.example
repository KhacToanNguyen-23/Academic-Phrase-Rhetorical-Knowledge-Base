# ---- App ----
APP_ENV=local
APP_SECRET_KEY=change-me
# Danh sách dạng JSON (pydantic-settings parse list[str] từ JSON)
API_CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Sentence boundaries and syntax features. spacy is the recommended engine: it is required
# for the Tier 2 hybrid slot engine. It fails clearly at ingest when spaCy or NLP_MODEL is
# unavailable; install both first (see README, "spaCy and Tier 2"). Use regex for a
# dependency-free setup, then also set MINING_HYBRID_ENABLED=false.
NLP_ENGINE=spacy
NLP_MODEL=en_core_web_sm

# ---- Postgres (D2) ----
POSTGRES_USER=aprkb
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=aprkb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aprkb:replace-with-a-local-password@localhost:5432/aprkb

# ---- Blob store (D4): thư mục local qua BlobStore, chưa dùng MinIO ----
BLOB_DIR=./data/blobs

# Job queue (D3) dùng bảng `jobs` trong Postgres, không cần Redis/Celery.

# ---- Article source adapter (ADR-0005) ----
# "null" disables external imports; "slr" enables the SLR Repository API adapter.
ARTICLE_SOURCE=null
SLR_API_BASE_URL=https://slr-api.hyperdatalab.org/api
SLR_API_KEY=
SLR_TIMEOUT_SECONDS=30
SLR_MAX_RETRIES=3
SLR_MAX_DOWNLOAD_BYTES=52428800
# Development only: license assigned to SLR works without one (e.g. DEV-UNVERIFIED).
# Refused unless APP_ENV is local or test. TODO(owner, BR-10): leave empty in production.
SLR_DEV_FALLBACK_LICENSE=
ARTICLE_IMPORT_BATCH_LIMIT=20

# ---- Gold labeling (Phase 03; disabled by default) ----
GOLD_LABELER=null
GROQ_API_KEY=
# Enable only after the source license permits external AI processing (TODO(owner, BR-10)).
GROQ_ALLOW_EXTERNAL_PROCESSING=false

# ---- NLP services (M2, chưa dùng ở scaffold) ----
GROBID_URL=http://localhost:8070
LANGUAGETOOL_URL=http://localhost:8010

# ---- Privacy (NFR-05) ----
STORE_MANUSCRIPT_RAW=false
RECOMMENDATION_LOG_RETENTION_DAYS=90

# ---- Mining (FR-06.2) ----
# Tier 2 hybrid slot engine. Needs stored tokens, so articles must be ingested with NLP_ENGINE=spacy.
MINING_HYBRID_ENABLED=true
# ADR-0015: separate Metric & Measurement catalog (/v1/measurements, /measurements).
MEASUREMENT_ENABLED=false

# Google Identity Services client; register localhost origins in Google Cloud.
GOOGLE_CLIENT_ID=
