{
  "name": "@aprkb/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:inspect": "tsc -b && vite build --mode inspect --outDir dist-inspect",
    "preview": "vite preview",
    "preview:inspect": "vite preview --outDir dist-inspect --port 4174",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../../packages/contracts/openapi/openapi.json -o src/shared/api/schema.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.87.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "openapi-fetch": "^0.13.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "^7.4.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0"
  }
}
